{
  "name": "rasp-react-native",
  "version": "0.1.0",
  "description": "Runtime Application Self-Protection (RASP) toolkit for React Native - root/jailbreak, debugger, tamper and hook detection.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "rasp-react-native.podspec",
    "LICENSE",
    "!android/build",
    "!ios/build",
    "!**/__tests__"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf lib"
  },
  "keywords": [
    "react-native",
    "security",
    "rasp",
    "root-detection",
    "jailbreak-detection"
  ],
  "repository": "https://github.com/avibra/rasp-react-native",
  "author": "Avibra",
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "react-native-builder-bob": "^0.23.2",
    "@types/react": "^18.2.0",
    "typescript": "^5.3.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": ["commonjs", "module", "typescript"]
  }
}
